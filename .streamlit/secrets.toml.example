# Copy this file to secrets.toml and fill in real values.
# secrets.toml is git-ignored and must NEVER be committed.

# ── Google Gemini (AI vision + advisory) ─────────────────
GEMINI_API_KEY = ""

# ── Supabase (auth + data + storage) ─────────────────────
SUPABASE_URL = ""
SUPABASE_ANON_KEY = ""
# Optional: enables service-level schema/table provisioning helpers.
SUPABASE_SERVICE_ROLE_KEY = ""

# ── Local admin fallback (optional) ──────────────────────
# If ADMIN_PASSWORD is left blank, the offline admin login is disabled
# and only Supabase authentication is available.
ADMIN_USERNAME = ""
ADMIN_EMAIL = ""
ADMIN_PASSWORD = ""

# ── DHIS2 integration (optional) ─────────────────────────
#
# Registry UIDs are NOT hardcoded in the app: a DHIS2 UID identifies a thing inside one
# instance, so the same LGA has a different UID on the demo server and on a national one.
# Both maps below are read as JSON objects and default to empty — an unmapped name appears
# in the export as UNMAPPED_… rather than being dropped, and the submit path refuses it.
#
# `python scripts/fetch_dhis2_uids.py --skeleton` queries the instance configured here and
# prints a DHIS2_ORG_UNIT_MAP skeleton keyed by the LGAs the Site Log records.
#
# The public DHIS2 demo (Sierra Leone database) is useful for testing the transport:
#   BASE_URL = "https://play.im.dhis2.org/dev"   # admin / district
DHIS2_ORG_UNIT_MAP = ""      # '{"Maiduguri": "<uid>", "Jere": "<uid>"}'
DHIS2_DATA_ELEMENT_MAP = ""  # '{"Anopheles": "<uid>", "Culex": "<uid>", "Aedes": "<uid>", "Other": "<uid>"}'

[DHIS2_ENV]
BASE_URL = ""
USERNAME = ""
PASSWORD = ""
